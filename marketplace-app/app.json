{
  "expo": {
    "name": "Shelby",
    "slug": "shelby",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:hireshelby.com"
      ],
      "bundleIdentifier": "com.hireshelby.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF7F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hireshelby.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "hireshelby.com",
              "pathPrefix": "/p/"
            },
            {
              "scheme": "https",
              "host": "hireshelby.com",
              "pathPrefix": "/s/"
            },
            {
              "scheme": "https",
              "host": "hireshelby.com",
              "pathPrefix": "/d/"
            },
            {
              "scheme": "https",
              "host": "hireshelby.com",
              "pathPrefix": "/w/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.hireshelby.app",
          "enableGooglePay": true
        }
      ],
      "expo-video"
    ],
    "scheme": "shelby",
    "experiments": {
      "typedRoutes": false
    }
  }
}
