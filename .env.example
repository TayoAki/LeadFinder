# Treg — one token for every data provider (https://treg.to)
TREG_TOKEN=
TREG_BASE_URL=https://treg.to
# AI for ICP writing and opening lines — set ONE of these. OpenRouter wins if both are set.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Optional model overrides (OpenRouter ids look like anthropic/claude-opus-5.5)
# LEADFINDER_ICP_MODEL=
# LEADFINDER_LINE_MODEL=
# SQLite file. On Railway, mount a volume at /data and set DATABASE_PATH=/data/leadfinder.db
DATABASE_PATH=./data/leadfinder.db
# What one credit sells for in USD, used for the admin margin view until Stripe top-ups exist
LEADFINDER_CREDIT_USD=0.02
# Public URL of the app (Stripe sends buyers back here), e.g. https://leadfinder.up.railway.app
APP_URL=http://localhost:3000
# Stripe card top-ups (leave empty to hide the Buy buttons)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: override credit packs, prices in US cents
# LEADFINDER_PACKS=[{"id":"starter","credits":500,"cents":1000,"label":"Starter"}]
