{
 "app": "Watchpost: managed threat detection and response for small businesses (built on Wazuh)",
 "personas": [
  {
   "id": "owner",
   "department": "Executive",
   "role": "Owner of a 40-person dental group (3 offices)",
   "cares_about": "Keeping the practice open, protecting patient data, passing the cyber-insurance renewal, not ending up in the news.",
   "time_spent": "Running the business; looks at security only when an email or invoice forces it.",
   "struggles": "Security reports are full of jargon; can't tell whether they're actually protected.",
   "how_helps": "Overview says in one sentence whether they're protected and what, if anything, the team must do, with plain-English labels, insurance and HIPAA status, and one dated monthly report.",
   "tasks": [
    {
     "name": "Own company status is honest about silent devices and labels urgent items",
     "steps": [
      {
       "select": "#role",
       "value": "owner"
      },
      {
       "click": "[data-tab='overview']"
      }
     ],
     "expect": [
      "[data-testid='ctx']:has-text('BrightSmile Dental Group')",
      "[data-testid='status']:has-text('Action needed · 4 urgent')",
      "[data-testid='status']:has-text('NAS-BACKUP')",
      "[data-testid='k-threats']:has-text('2')",
      "[data-testid='k-devices']:has-text('60 of 64')",
      "[data-testid='urgent-actions']",
      "[data-testid='month-actions']",
      ".rail [data-view='alerts'] .badge:has-text('4')",
      "[data-testid='sla']:has-text('15 minutes')",
      ".tabs:not(:has([data-tab='partner']))",
      ".app:not(:has([data-select='harbor']))",
      "[data-testid='status']:has-text('reconnect the other 3 silent devices')",
      "[data-testid='k-threats'] + .delta:has-text('1 open (agent removed on FRONTDESK-05)')"
     ]
    },
    {
     "name": "Own plan, annual cost and real payment method",
     "steps": [
      {
       "select": "#role",
       "value": "owner"
      },
      {
       "click": "[data-tab='billing']"
      }
     ],
     "expect": [
      "[data-testid='plan']:has-text('$999/mo')",
      "[data-testid='annual']:has-text('$11,988')",
      "#panel-billing:has-text('7319')",
      "#panel-billing:not(:has-text('4242'))",
      "#panel-billing:not(:has-text('wholesale'))",
      "[data-testid='cost-value']:has-text('$25,000')",
      "[data-testid='annual']:not(:has-text('vs cyber premium'))"
     ]
    }
   ]
  },
  {
   "id": "office_mgr",
   "department": "Operations",
   "role": "Office manager who is the 'accidental IT person'",
   "cares_about": "Staff can work, no downtime, knowing what to do when something happens.",
   "time_spent": "Scheduling, vendors, front desk, fixing printers and passwords.",
   "struggles": "Gets alerts she doesn't understand and doesn't know if she must act.",
   "how_helps": "The incident that needs her opens first, says what analysts already did and exactly what she must do, and lets her mark it done or ask an analyst.",
   "tasks": [
    {
     "name": "Her open task comes first, she can ask Marco and an analyst",
     "steps": [
      {
       "select": "#role",
       "value": "office"
      },
      {
       "click": "[data-tab='incidents']"
      },
      {
       "click": "[data-testid='ask-it']"
      },
      {
       "click": "[data-testid='ask-bs1']"
      }
     ],
     "expect": [
      "[data-testid='incident-bs1'][aria-expanded='true']",
      "#inc-detail-bs1 [data-testid='we-did']:has-text('Sam T.')",
      "[data-testid='pw-requested']:has-text('Marco Diaz')",
      "[data-testid='thread-bs1']:has-text('usually answered within 15 minutes')",
      "[data-testid='incident-bs1'] .who:has-text('You')",
      "#inc-detail-bs1 [data-testid='breach-line']:has-text('No patient data exposed')",
      "#inc-detail-bs1 [data-testid='breach'] details:not([open])"
     ]
    },
    {
     "name": "Notifications default to her own tasks",
     "steps": [
      {
       "select": "#role",
       "value": "office"
      },
      {
       "click": ".rail [data-view='alerts']"
      }
     ],
     "expect": [
      "#pop [data-testid='notif-mine'][aria-pressed='true']",
      "#pop [data-testid='notifications']:has-text('reception@')",
      "#pop [data-testid='notifications']:not(:has-text('KB5068861'))"
     ]
    },
    {
     "name": "Marking done updates badge and headline",
     "steps": [
      {
       "select": "#role",
       "value": "office"
      },
      {
       "click": "[data-tab='incidents']"
      },
      {
       "click": "[data-testid='done-bs1']"
      },
      {
       "click": "[data-tab='overview']"
      }
     ],
     "expect": [
      ".rail [data-view='alerts'] .badge:has-text('3')",
      "[data-testid='status']:has-text('3 urgent')",
      ".tabs:not(:has([data-tab='billing']))",
      "[data-testid='your-tasks']"
     ]
    }
   ]
  },
  {
   "id": "it_mgr",
   "department": "IT",
   "role": "In-house IT manager",
   "cares_about": "Full coverage, patched systems, fewer false alarms.",
   "time_spent": "Tickets, patching, onboarding laptops, chasing devices that fall off monitoring.",
   "struggles": "Alert fatigue and blind spots (devices that stopped reporting).",
   "how_helps": "Devices tab lists silent devices by business impact with reasons, install commands and the one update to fix first; Incidents shows how much noise analysts filtered; search finds a host across logs.",
   "tasks": [
    {
     "name": "Silent devices by impact, real KB and CVE, tamper incident linked",
     "steps": [
      {
       "select": "#role",
       "value": "it"
      },
      {
       "click": "[data-tab='devices']"
      }
     ],
     "expect": [
      "[data-testid='not-reporting']:has-text('4 devices')",
      "[data-testid='not-reporting'] tbody tr:first-child:has-text('NAS-BACKUP')",
      "[data-testid='top-vuln']:has-text('KB5068861')",
      "[data-testid='top-vuln']:has-text('CVE-2026-41132')",
      "#panel-devices:not(:has-text('placeholder'))",
      "[data-open-inc='brightsmile:bs4']",
      "[data-testid='device-table']:not(:has-text('HYGIENE-LT-1'))",
      "[data-testid='copy-install']"
     ]
    },
    {
     "name": "Office 2 filter changes the fix-first card too",
     "steps": [
      {
       "select": "#role",
       "value": "it"
      },
      {
       "click": "[data-tab='devices']"
      },
      {
       "select": "#dev-site",
       "value": "Office 2 (Elm Ave)"
      }
     ],
     "expect": [
      "[data-testid='not-reporting']:has-text('1 device')",
      "[data-testid='top-vuln']:has-text('Nothing critical here')",
      "[data-testid='top-vuln']:has-text('Company-wide')",
      "[data-testid='device-table']:has-text('XRAY-PC-3')",
      "[data-testid='device-table'] .risk.medium"
     ]
    },
    {
     "name": "Search a host from the rail",
     "steps": [
      {
       "select": "#role",
       "value": "it"
      },
      {
       "click": ".rail [data-view='search']"
      },
      {
       "click": "#pop [data-q='FRONTDESK-02']"
      }
     ],
     "expect": [
      "#search-results:has-text('invoice_8812.pdf.exe')"
     ]
    },
    {
     "name": "Alert noise and the tamper incident",
     "steps": [
      {
       "select": "#role",
       "value": "it"
      },
      {
       "click": "[data-tab='incidents']"
      }
     ],
     "expect": [
      "[data-testid='noise']:has-text('1,240')",
      "[data-testid='noise']:has-text('1 open (agent removed on FRONTDESK-05)')",
      "#inc-detail-bs4 [data-testid='you-do']:has-text('reinstall')",
      "[data-testid='noise-sources']:has-text('svc-backup')",
      "[data-testid='incident-bs4'] .sev:has-text('High')",
      "#inc-detail-bs4 [data-testid='linked-leaver']:has-text('Mia Reyes')",
      "[data-testid='incident-bs4'][aria-expanded='true']"
     ]
    }
   ]
  },
